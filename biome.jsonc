{
  // One lint/format layer, single config at the root. Formatter options match
  // the incumbent style so adoption stays lint-value, not a reformat.
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    // Generated eval artifacts: written by the eval harnesses via
    // JSON.stringify(.., 2), whose array style biome's formatter would rewrite
    // (and the next eval run would rewrite back). Not biome's to own.
    "includes": ["**", "!evals/results.json", "!evals/external/results-*.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        // = prettier-plugin-tailwindcss: one canonical utility order in class
        // attributes and the cn/cva/clsx call sites.
        "useTailwindSortedClasses": "error"
      },
      "style": {
        // = eslint react-refresh/only-export-components (vite preset).
        "useComponentExportOnlyModules": {
          "level": "warn",
          "options": { "allowConstantExport": true }
        }
      },
      "suspicious": {
        "noConsole": { "level": "off", "options": { "allow": ["log"] } }
      }
    }
  },
  "overrides": [
    {
      // WAI-ARIA tabs pattern: the tabpanel carries tabIndex={0} by design
      // (focusable panel with no focusable content inside); the rule cannot
      // see the authoring-practices convention.
      "includes": ["apps/dashboard/src/App.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveTabindex": "off"
          }
        }
      }
    }
  ],
  // Import order encodes shadcn's prettier importOrder taxonomy (react,
  // third-party, blank, the @/ groups in shadcn's sequence, blank, relative).
  // ":BLANK_LINE:" is the separator token.
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ["react", "react/**"],
              [":BUN:", ":NODE:", ":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:"],
              ":BLANK_LINE:",
              "@/types/**",
              "@/config/**",
              "@/lib/**",
              "@/hooks/**",
              "@/components/ui/**",
              "@/components/**",
              "@/styles/**",
              "@/app/**",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  // Biome 2.6 formats and lints Markdown and YAML by default. Neither was
  // biome's before (pnpm-lock.yaml is pnpm's to write), so both stay off.
  "markdown": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "yaml": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  // The call sites useTailwindSortedClasses checks (cva's variants included).
  "tailwind": {
    "mergeFunctions": ["cn", "clsx", "tw"],
    "variantFunctions": ["cva"]
  }
}
